{
	"name": "HEIG-VD ProgServ2 Course Development Container",
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
	"workspaceFolder": "/workspace",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
			"moby": false
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"bmewburn.vscode-intelephense-client",
				"cweijan.vscode-database-client2",
				"DavidAnson.vscode-markdownlint",
				"esbenp.prettier-vscode",
				"GitHub.copilot",
				"jebbs.plantuml",
				"marp-team.marp-vscode",
				"qwtel.sqlite-viewer",
				"redhat.vscode-yaml",
				"streetsidesoftware.code-spell-checker",
				"streetsidesoftware.code-spell-checker-french",
				"tomoki1207.pdf",
				"xdebug.php-debug",
				"yzhang.markdown-all-in-one"
			]
		}
	},
	"forwardPorts": [3306, 8025, 8080, 8888, 9090],
	"portsAttributes": {
		"3306": {
			"label": "MariaDB Database"
		},
		"8025": {
			"label": "Mailpit SMTP Server"
		},
		"8080": {
			"label": "Apache HTTP Server"
		},
		"8888": {
			"label": "PlantUML Server"
		},
		"9090": {
			"label": "phpMyAdmin Web Interface"
		}
	},
	// Execute the post-create.sh script once the container is created
	"postCreateCommand": ".devcontainer/post-create.sh"
}
